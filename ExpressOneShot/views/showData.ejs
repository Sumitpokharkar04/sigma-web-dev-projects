<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title></title>
</head>
<body>
    <h1>hello</h1>
    <table border="1">
        <tr>
            <td>name</td>
            <td>age</td>
            <td>email</td>
            <td>operation</td>
        </tr>
        
        <% students.forEach(student=>{ %>
            <tr>
            <td><%=student.name%></td>
            <td><%=student.age%></td>
            <td><%=student.email%></td>
            <td><a href="/delete/<%=student._id%>">delete</a></td>
            <td><a href="/update/<%=student._id%>">update</a></td>
        </tr>
        <%})%>

    </table>
</body>
</html>